# Copy this file to `.env` and fill in real values. Never commit `.env`.

NODE_ENV=development
PORT=4000

# Number of reverse proxies in front of the API (Render/Railway = 1). Used for correct client IPs in rate limiting.
TRUST_PROXY=0

# MongoDB Atlas connection string (use a database user with readWrite on this database only).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority

# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Long random string (at least 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Cookie settings. With the recommended setup (Next.js proxies /api to this server) `lax` is correct.
# Use `none` only if the browser calls the API directly on a different site (requires HTTPS).
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Login brute-force protection
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Email notifications for contact/quote submissions (https://resend.com). Leave empty to disable.
RESEND_API_KEY=
EMAIL_FROM=Portfolio <notifications@yourdomain.com>
ADMIN_NOTIFY_EMAIL=

# Cloudflare Turnstile secret key. Leave empty to disable bot checks (not recommended in production).
TURNSTILE_SECRET_KEY=

# Uploads: `local` (dev only, files in ./uploads) or `cloudinary`
STORAGE_DRIVER=local
UPLOAD_MAX_MB=5
PUBLIC_API_URL=http://localhost:4000
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Used only by `npm run seed:admin`
ADMIN_SEED_EMAIL=
ADMIN_SEED_NAME=Admin
ADMIN_SEED_PASSWORD=
