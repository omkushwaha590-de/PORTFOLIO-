# Copy to `.env.local` for development. Never commit real values.

# Server-only: where the Express API runs. Used by server components and the /api/v1 rewrite.
# Do NOT prefix with NEXT_PUBLIC_ — it must never reach the browser bundle.
BACKEND_URL=http://localhost:4000

# Public site URL (used for metadata, sitemap and Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile *site* key (public by design). Leave empty to disable the widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only shared secret; must match INTERNAL_API_KEY on the backend. Lets the backend rate-limit
# per visitor while exempting this server's own page renders. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
INTERNAL_API_KEY=
